<Application x:Class="GameStudioClicker.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:GameStudioClicker.Wpf.Converters"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Animations.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:CompactNumberConverter
                x:Key="CompactNumberConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
