<Window x:Class="GameStudioClicker.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Game Studio Clicker"
        Height="800"
        Width="1200"
        MinHeight="500"
        MinWidth="700"
        Background="#18181B"
        Foreground="#F4F4F5">

    <Window.Resources>
        <!-- Shared appearance and interaction states for clickable game actions. -->
        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">
            <Setter Property="Background" Value="#3F3F46" />
            <Setter Property="Foreground" Value="#F4F4F5" />
            <Setter Property="BorderBrush" Value="#52525B" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <!-- Visual states belong to the reusable button template. -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#45454B" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#38383E" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#303034" />
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#38383E" />
                                <Setter Property="Foreground"
                                        Value="#777780" />
                                <Setter Property="Cursor"
                                        Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Makes an entire worker card behave like one large purchase button. -->
        <Style x:Key="WorkerCardButtonStyle"
               TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F4F4F5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.96" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.85" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Global tooltip appearance used by active-upgrade details. -->
        <Style TargetType="{x:Type ToolTip}">
            <Setter Property="Background"
                    Value="#27272A" />
            <Setter Property="Foreground"
                    Value="#F4F4F5" />
            <Setter Property="BorderBrush"
                    Value="#52525B" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Padding"
                    Value="12" />
            <Setter Property="Placement"
                    Value="Bottom" />
            <Setter Property="HasDropShadow"
                    Value="True" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToolTip}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header and notifications. -->
            <RowDefinition Height="Auto" />
            <!-- Main game interface. -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Optional save confirmation overlay; currently kept hidden by ViewModel usage. -->
        <Border Grid.Row="0"
                Panel.ZIndex="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Padding="10,6"
                Background="#27272A"
                BorderBrush="#3F3F46"
                BorderThickness="1"
                CornerRadius="6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility"
                            Value="Collapsed" />

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSaveConfirmation}"
                                     Value="True">
                            <Setter Property="Visibility"
                                    Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <TextBlock Text="Game Saved!"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#86EFAC" />
        </Border>

        <!-- Main two-column game layout -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <!-- Production Summary -->
                <RowDefinition Height="Auto" />
                <!-- Progression content -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Compact production and active-upgrade dashboard -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <!-- Game identity -->
                    <ColumnDefinition Width="*" />

                    <!-- Main game action -->
                    <ColumnDefinition Width="*" />

                    <!-- Active upgrades -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Game title balances the left side of the dashboard. -->
                <StackPanel Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="Game Studio"
                               FontSize="52"
                               FontWeight="Bold" />

                    <TextBlock Text="Clicker!"
                               FontSize="52"
                               FontWeight="Bold" />
                </StackPanel>

                <!-- Manual coding and current production -->
                <Border Grid.Column="1"
                        Width="280"
                        HorizontalAlignment="Center"
                        Padding="10"
                        BorderThickness="1"
                        Background="#27272A"
                        BorderBrush="#3F3F46"
                        CornerRadius="8">

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <!-- Current resource total -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="{Binding LinesOfCode,
                                       Converter={StaticResource CompactNumberConverter}}"
                                       FontSize="24"
                                       FontWeight="Bold" />

                            <TextBlock Text=" Lines of Code"
                                       FontSize="24"
                                       FontWeight="Bold" />
                        </StackPanel>

                        <!-- Main click action and floating +X feedback -->
                        <Grid x:Name="ClickFeedbackLayer"
                              Height="70"
                              Margin="0,4,0,4">
                            <Button Content="Write Code"
                                    Width="150"
                                    Height="50"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Command="{Binding WriteCodeCommand}"
                                    Click="WriteCodeButton_Click"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </Grid>

                        <!-- Passive production -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="{Binding LinesPerSecond,
                                       Converter={StaticResource CompactNumberConverter}}"
                                       FontSize="16"
                                       FontWeight="SemiBold" />

                            <TextBlock Text=" Lines / second"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Notifications and active upgrades share the right dashboard column. -->
                <Grid Grid.Column="2"
                      Margin="24,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Temporary message shown when offline progress is applied. -->
                    <Border Grid.Row="0"
                            MaxWidth="360"
                            Padding="10,8"
                            HorizontalAlignment="Center"
                            Background="#2F2F33"
                            BorderBrush="#45454B"
                            BorderThickness="1"
                            CornerRadius="6">

                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasOfflineEarnings}"
                                                 Value="False">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <TextBlock Text="{Binding OfflineEarningsMessage}"
                                   Foreground="#D4D4D8"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />
                    </Border>

                    <!-- Compact, one-time active upgrades -->
                    <StackPanel Grid.Row="1"
                                Margin="0,8,0,0"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Center">

                        <TextBlock Text="Active Upgrades"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8" />

                        <ItemsControl ItemsSource="{Binding ActiveUpgrades}">
                            <!-- Arrange compact upgrade buttons from left to right. -->
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- One active-upgrade button -->
                                    <Button Width="60"
                                            Height="60"
                                            Margin="4,4,8,8"
                                            Padding="4"
                                            ToolTipService.InitialShowDelay="150"
                                            ToolTipService.BetweenShowDelay="0"
                                            ToolTipService.ShowDuration="30000"
                                            ToolTipService.ShowOnDisabled="True"
                                            RenderTransformOrigin="0.5,0.5"
                                            Command="{Binding DataContext.PurchaseActiveUpgradeCommand,
                                            RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                            CommandParameter="{Binding}">

                                        <!-- Used by the one-time affordability pulse. -->
                                        <Button.RenderTransform>
                                            <ScaleTransform ScaleX="1"
                                                            ScaleY="1" />
                                        </Button.RenderTransform>

                                        <Button.Style>
                                            <Style TargetType="Button"
                                                   BasedOn="{StaticResource PrimaryButtonStyle}">
                                                <Setter Property="Visibility"
                                                        Value="Visible" />

                                                <Style.Triggers>
                                                    <!-- Purchased or distant upgrades are removed by the ViewModel. -->
                                                    <DataTrigger Binding="{Binding IsVisible}"
                                                                 Value="False">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                    </DataTrigger>

                                                    <!-- Pulse once when a visible upgrade becomes purchasable. -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsVisible}"
                                                                       Value="True" />
                                                            <Condition Binding="{Binding CanPurchaseActiveUpgrade}"
                                                                       Value="True" />
                                                        </MultiDataTrigger.Conditions>

                                                        <MultiDataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                        From="1"
                                                                        To="1.12"
                                                                        Duration="0:0:0.15"
                                                                        AutoReverse="True"
                                                                        FillBehavior="Stop" />

                                                                    <DoubleAnimation
                                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                        From="1"
                                                                        To="1.12"
                                                                        Duration="0:0:0.15"
                                                                        AutoReverse="True"
                                                                        FillBehavior="Stop" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </MultiDataTrigger.EnterActions>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>

                                        <!-- Temporary generic upgrade icon -->
                                        <TextBlock Text="↑"
                                                   FontSize="24"
                                                   FontWeight="Bold" />

                                        <Button.ToolTip>
                                            <ToolTip DataContext="{Binding PlacementTarget.DataContext,
                                                     RelativeSource={RelativeSource Self}}">
                                                <StackPanel MaxWidth="260">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="16"
                                                               FontWeight="Bold"
                                                               Margin="0,0,0,6" />

                                                    <TextBlock Text="{Binding Description}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,0,0,8" />

                                                    <TextBlock FontWeight="SemiBold">
                                                        <Run Text="Cost: " />
                                                        <Run Text="{Binding Cost, Mode=OneWay, Converter={StaticResource CompactNumberConverter}}" />
                                                        <Run Text=" Lines of Code" />
                                                    </TextBlock>

                                                    <!-- Only visible while an upgrade or worker requirement is unmet. -->
                                                    <TextBlock Text="{Binding RequirementText}"
                                                               Foreground="#FCA5A5"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               Margin="0,8,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility"
                                                                        Value="Collapsed" />

                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasUnmetRequirement}"
                                                                                 Value="True">
                                                                        <Setter Property="Visibility"
                                                                                Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

            </Grid>

            <!-- Scrollable progression area -->
            <ScrollViewer Grid.Row="1"
                          Margin="0,16,0,0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">

                <!-- Repeatable worker upgrades -->
                <ItemsControl ItemsSource="{Binding WorkerUpgrades}"
                              VerticalAlignment="Top">
                    <!-- Keep worker cards in two equal-width columns. -->
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- The whole worker card purchases the represented worker. -->
                            <Button Height="150"
                                    Margin="6"
                                    Command="{Binding DataContext.PurchaseWorkerUpgradeCommand,
                                    RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                    CommandParameter="{Binding}">

                                <!-- Hidden future workers do not show an empty card. -->
                                <Button.Style>
                                    <Style TargetType="Button"
                                           BasedOn="{StaticResource WorkerCardButtonStyle}">
                                        <Setter Property="Visibility"
                                                Value="Visible" />

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsVisible}"
                                                         Value="False">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>

                                <!-- Brief confirmation flash after a successful purchase. -->
                                <Button.Triggers>
                                    <EventTrigger RoutedEvent="Button.Click">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation
                                                    Storyboard.TargetName="WorkerCard"
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    From="#27272A"
                                                    To="#2D3330"
                                                    Duration="0:0:0.1"
                                                    AutoReverse="True"
                                                    FillBehavior="Stop" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Button.Triggers>

                                <!-- Card contents are retained while the surrounding button handles hiring. -->
                                <Border x:Name="WorkerCard"
                                        Padding="12"
                                        BorderBrush="#3F3F46"
                                        BorderThickness="1"
                                        CornerRadius="8">

                                    <Border.Background>
                                        <!-- Explicit brush enables the purchase color animation. -->
                                        <SolidColorBrush Color="#27272A" />
                                    </Border.Background>

                                    <Grid>
                                        <!-- Details and purchase controls for an unlocked worker. -->
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility"
                                                            Value="Visible" />

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMystery}"
                                                                     Value="True">
                                                            <Setter Property="Visibility"
                                                                    Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <TextBlock Text="{Binding DisplayName}"
                                                       HorizontalAlignment="Center"
                                                       FontSize="18"
                                                       FontWeight="Bold" />

                                            <TextBlock Text="{Binding Description}"
                                                       HorizontalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,12" />

                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center">
                                                <TextBlock Text="Cost: " />
                                                <TextBlock Text="{Binding CurrentCost, Converter={StaticResource CompactNumberConverter}}" />
                                                <TextBlock Text=" Lines of Code" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,4,0,4">
                                                <TextBlock Text="Employees: " />
                                                <TextBlock Text="{Binding WorkerCount, Converter={StaticResource CompactNumberConverter}}" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,0,0,8">
                                                <TextBlock Text="Current Production: " />
                                                <TextBlock Text="{Binding CurrentLinesPerSecond, Converter={StaticResource CompactNumberConverter}}" />
                                                <TextBlock Text=" Lines of Code / Second" />
                                            </StackPanel>

                                        </StackPanel>

                                        <!-- Limited information for the next locked worker. -->
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Margin="0,12">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility"
                                                            Value="Collapsed" />

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMystery}"
                                                                     Value="True">
                                                            <Setter Property="Visibility"
                                                                    Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <TextBlock Text="???"
                                                       HorizontalAlignment="Center"
                                                       FontSize="26"
                                                       FontWeight="Bold"
                                                       Foreground="#A1A1AA" />

                                            <StackPanel Orientation="Vertical"
                                                        HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding UnlockRequirementText}"
                                                           HorizontalAlignment="Center"
                                                           Foreground="#71717A"
                                                           Margin="0,6,0,0" />

                                                <TextBlock HorizontalAlignment="Center"
                                                           Foreground="#71717A"
                                                           Margin="4,6,0,0">
                                                    <Run Text="Cost: " />
                                                    <Run Text="{Binding CurrentCost, Mode=OneWay, Converter={StaticResource CompactNumberConverter}}" />
                                                    <Run Text=" Lines of Code" />
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
