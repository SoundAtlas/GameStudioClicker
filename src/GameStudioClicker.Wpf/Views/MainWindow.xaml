<Window x:Class="GameStudioClicker.Wpf.Views.MainWindow"
        xmlns:views="clr-namespace:GameStudioClicker.Wpf.Views"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Game Studio Clicker"
        Icon="/Assets/Branding/AppIcon/app_icon_game_studio_clicker.png"
        Height="800"
        Width="1200"
        MinHeight="500"
        MinWidth="700"
        Background="{StaticResource GameBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="{StaticResource BodyFontFamily}">

    <Window.Resources>
        <!-- Shared appearance and interaction states for clickable game actions. -->
        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <!-- Visual states belong to the reusable button template. -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource PrimaryCyanBrush}" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource PrimaryCyanBrush}" />
                                <Setter Property="Foreground"
                                        Value="{StaticResource GameBackgroundBrush}" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource GameBackgroundBrush}" />
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource BorderBrush}" />
                                <Setter Property="Foreground"
                                        Value="{StaticResource SecondaryTextBrush}" />
                                <Setter Property="Cursor"
                                        Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButtonStyle"
               TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryCyanBrush}" />
            <Setter Property="Foreground" Value="{StaticResource GameBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlowBlueBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <!-- Visual states belong to the reusable button template. -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource PrimaryTextBrush}" />
                                <Setter Property="Background"
                                        Value="{StaticResource GlowBlueBrush}" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource PressedPrimaryBrush}" />
                                <Setter Property="Foreground"
                                        Value="{StaticResource GameBackgroundBrush}" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource GameBackgroundBrush}" />
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource BorderBrush}" />
                                <Setter Property="Foreground"
                                        Value="{StaticResource SecondaryTextBrush}" />
                                <Setter Property="Cursor"
                                        Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Makes an entire worker card behave like one large purchase button. -->
        <Style x:Key="WorkerCardButtonStyle"
               TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.85" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Global tooltip appearance used by active-upgrade details. -->
        <Style TargetType="{x:Type ToolTip}">
            <Setter Property="FontFamily"
                    Value="{StaticResource BodyFontFamily}" />
            <Setter Property="Background"
                    Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Padding"
                    Value="12" />
            <Setter Property="Placement"
                    Value="Bottom" />
            <Setter Property="HasDropShadow"
                    Value="True" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToolTip}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header and notifications. -->
            <RowDefinition Height="Auto" />
            <!-- Main game interface. -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Optional save confirmation overlay; currently kept hidden by ViewModel usage. -->
        <Border Grid.Row="0"
                Panel.ZIndex="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Padding="10,6"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility"
                            Value="Collapsed" />

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSaveConfirmation}"
                                     Value="True">
                            <Setter Property="Visibility"
                                    Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <TextBlock Text="Game Saved!"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource SuccessBrush}" />
        </Border>

        <!-- Main two-column game layout. -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <!-- Production summary. -->
                <RowDefinition Height="Auto" />
                <!-- Progression content. -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Compact production and active-upgrade dashboard. -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <!-- Game identity -->
                    <ColumnDefinition Width="*" />

                    <!-- Main game action -->
                    <ColumnDefinition Width="*" />

                    <!-- Active upgrades -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="/Assets/Branding/Logo/logo_game_studio_clicker.png"
                       MaxWidth="300"
                       MaxHeight="150"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,0,0,4"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       SnapsToDevicePixels="True" />

                <!-- Manual coding and current production. -->
                <Border Grid.Column="1"
                        Width="280"
                        HorizontalAlignment="Center"
                        Padding="10"
                        BorderThickness="1"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        CornerRadius="8">

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <!-- Current resource total. -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <Image Source="/Assets/Icons/Currency/icon_lines_of_code.png"
                                   Width="42"
                                   Height="42"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   SnapsToDevicePixels="True"/>

                            <TextBlock Text="{Binding LinesOfCode,
                                       Converter={StaticResource CompactNumberConverter}}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                        <!-- Main click action and floating +X feedback. -->
                        <Grid x:Name="ClickFeedbackLayer"
                              Height="70"
                              Margin="0,4,0,4"
                              ClipToBounds="False">
                            <Button Content="Write Code"
                                    Width="150"
                                    Height="50"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Command="{Binding WriteCodeCommand}"
                                    Click="WriteCodeButton_Click"
                                    Style="{StaticResource PrimaryActionButtonStyle}" />
                        </Grid>

                        <!-- Passive production. -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="{Binding LinesPerSecond,
                                       Converter={StaticResource CompactNumberConverter}}"
                                       FontSize="16"
                                       FontWeight="SemiBold" />

                            <TextBlock Text=" Lines / second"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Notifications and active upgrades share the right dashboard column. -->
                <Grid Grid.Column="2"
                      Margin="24,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Temporary message shown when offline progress is applied. -->
                    <Border Grid.Row="0"
                            MaxWidth="360"
                            Padding="10,8"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Center"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Opacity="0">

                        <Border.RenderTransform>
                            <TranslateTransform X="16" />
                        </Border.RenderTransform>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Hidden" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasOfflineEarnings}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Storyboard="{StaticResource OfflineEarningsStoryboard}" />
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <TextBlock Text="{Binding OfflineEarningsMessage}"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />
                    </Border>

                    <!-- Compact, one-time active upgrades. -->
                    <StackPanel Grid.Row="1"
                                Margin="0,8,0,0"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Center">

                        <TextBlock Text="Active Upgrades"
                                   Style="{StaticResource SectionHeadingTextStyle}"
                                   Margin="0,0,0,8"
                                   HorizontalAlignment="Center"/>

                        <ItemsControl ItemsSource="{Binding ActiveUpgrades}">
                            <!-- Arrange compact upgrade buttons from left to right. -->
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- One active-upgrade button -->
                                    <Button Width="88"
                                            Height="88"
                                            Margin="4,4,8,8"
                                            Padding="6"
                                            ToolTipService.InitialShowDelay="150"
                                            ToolTipService.BetweenShowDelay="0"
                                            ToolTipService.ShowDuration="30000"
                                            ToolTipService.ShowOnDisabled="True"
                                            RenderTransformOrigin="0.5,0.5"
                                            Command="{Binding DataContext.PurchaseActiveUpgradeCommand,
                                            RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                            CommandParameter="{Binding}">

                                        <!-- Used by the one-time affordability pulse. -->
                                        <Button.RenderTransform>
                                            <ScaleTransform ScaleX="1"
                                                            ScaleY="1" />
                                        </Button.RenderTransform>

                                        <Button.Style>
                                            <Style TargetType="Button"
                                                   BasedOn="{StaticResource PrimaryButtonStyle}">
                                                <!-- Default appearance: unlocked, but not currently affordable. -->
                                                <Setter Property="Visibility"
                                                        Value="Visible" />
                                                <Setter Property="Opacity"
                                                        Value="0.45" />
                                                <Setter Property="BorderThickness"
                                                        Value="1" />

                                                <Style.Triggers>
                                                    <!-- Purchased or distant upgrades are removed by the ViewModel. -->
                                                    <DataTrigger Binding="{Binding IsVisible}"
                                                                 Value="False">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                    </DataTrigger>

                                                    <!-- The player can purchase this upgrade right now. -->
                                                    <DataTrigger Binding="{Binding CanPurchaseActiveUpgrade}"
                                                                 Value="True">
                                                        <Setter Property="Opacity"
                                                                Value="1" />
                                                        <Setter Property="BorderBrush"
                                                                Value="{StaticResource PrimaryCyanBrush}" />
                                                        <Setter Property="BorderThickness"
                                                                Value="2" />
                                                    </DataTrigger>

                                                    <!-- Pulse once when a visible upgrade becomes purchasable. -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsVisible}"
                                                                       Value="True" />
                                                            <Condition Binding="{Binding CanPurchaseActiveUpgrade}"
                                                                       Value="True" />
                                                        </MultiDataTrigger.Conditions>

                                                        <MultiDataTrigger.EnterActions>
                                                            <BeginStoryboard Storyboard="{StaticResource AvailabilityPulseStoryboard}" />
                                                        </MultiDataTrigger.EnterActions>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>


                                        <Grid>
                                            <Image Source="{Binding IconPath}"
                                                   Width="88"
                                                   Height="66"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                   SnapsToDevicePixels="True">
                                            </Image>

                                            <!-- Temporary generic upgrade icon -->
                                            <TextBlock Text="↑"
                                                       FontSize="28"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">

                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IconPath}"
                                                                         Value="{x:Null}">
                                                                <Setter Property="Visibility"
                                                                        Value="Visible" />

                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>

                                        <Button.ToolTip>
                                            <ToolTip DataContext="{Binding PlacementTarget.DataContext,
                                                     RelativeSource={RelativeSource Self}}">
                                                <StackPanel MaxWidth="260">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="16"
                                                               FontWeight="Bold"
                                                               Margin="0,0,0,6" />

                                                    <TextBlock Text="{Binding Description}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,0,0,8" />

                                                    <TextBlock FontWeight="SemiBold">
                                                        <Run Text="Cost: " />
                                                        <Run Text="{Binding Cost, Mode=OneWay, Converter={StaticResource CompactNumberConverter}}" />
                                                        <Run Text=" Lines of Code" />
                                                    </TextBlock>

                                                    <!-- Only visible while an upgrade or worker requirement is unmet. -->
                                                    <TextBlock Text="{Binding RequirementText}"
                                                               Foreground="{StaticResource ErrorBrush}"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               Margin="0,8,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility"
                                                                        Value="Collapsed" />

                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasUnmetRequirement}"
                                                                                 Value="True">
                                                                        <Setter Property="Visibility"
                                                                                Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Switchable Workers and Statistics area. -->
            <Grid Grid.Row="1"
                  Margin="0,16,0,0">

                <Grid.RowDefinitions>
                    <!-- Page navigation -->
                    <RowDefinition Height="Auto" />

                    <!-- Selected page -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0"
                        Content="Statistics"
                        HorizontalAlignment="Right"
                        Command="{Binding ToggleStatisticsCommand}"
                        ToolTip="Show or hide statistics">

                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Setter Property="Margin"
                                    Value="4" />

                            <Style.Triggers>
                                <!-- Highlight the buttons while statics is open -->
                                <DataTrigger Binding="{Binding IsStatisticsViewVisible}"
                                             Value="True">
                                    <Setter Property="Background"
                                            Value="{StaticResource BorderBrush}" />
                                    <Setter Property="BorderBrush"
                                            Value="{StaticResource PrimaryCyanBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Both pages occupy this same region. -->
                <Grid Grid.Row="1"
                      Margin="0,12,0,0"
                      ClipToBounds="False">

                    <!-- Existing worker page -->
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">


                        <!-- Repeatable worker upgrades. -->
                        <ItemsControl ItemsSource="{Binding WorkerUpgrades}"
                                      VerticalAlignment="Top">
                            <!-- Keep worker cards in two equal-width columns. -->
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- The whole worker card purchases the represented worker. -->
                                    <Button Height="150"
                                            Margin="6"
                                            RenderTransformOrigin="0.5,0.5"
                                            Command="{Binding DataContext.PurchaseWorkerUpgradeCommand,
                                            RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                            CommandParameter="{Binding}">

                                        <Button.RenderTransform>
                                            <ScaleTransform ScaleX="1"
                                                            ScaleY="1" />
                                        </Button.RenderTransform>

                                        <!-- Hidden future workers do not show an empty card. -->
                                        <Button.Style>
                                            <Style TargetType="Button"
                                                   BasedOn="{StaticResource WorkerCardButtonStyle}">
                                                <Setter Property="Visibility"
                                                        Value="Visible" />

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsVisible}"
                                                                 Value="False">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                    </DataTrigger>

                                                    <MultiTrigger>
                                                        <MultiTrigger.Conditions>
                                                            <Condition Property="IsMouseOver"
                                                                       Value="True" />

                                                            <Condition Property="IsEnabled"
                                                                       Value="True" />

                                                        </MultiTrigger.Conditions>

                                                        <MultiTrigger.EnterActions>
                                                            <BeginStoryboard Storyboard="{StaticResource SubtleHoverScaleInStoryboard}" />
                                                        </MultiTrigger.EnterActions>

                                                        <MultiTrigger.ExitActions>
                                                            <BeginStoryboard Storyboard="{StaticResource SubtleHoverScaleOutStoryboard}" />
                                                        </MultiTrigger.ExitActions>
                                                    </MultiTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>

                                        <!-- Brief confirmation flash after a successful purchase. -->
                                        <Button.Triggers>
                                            <EventTrigger RoutedEvent="Button.Click">
                                                <BeginStoryboard Storyboard="{StaticResource WorkerCardPurchaseFlashStoryboard}" />
                                            </EventTrigger>
                                        </Button.Triggers>

                                        <!-- Card contents are retained while the surrounding button handles hiring. -->
                                        <Border x:Name="WorkerCard"
                                                Padding="0"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">

                                            <Border.Background>
                                                <!-- Explicit brush enables the purchase color animation. -->
                                                <SolidColorBrush Color="{StaticResource SurfaceColor}" />
                                            </Border.Background>

                                            <Grid>
                                                <Border x:Name="HoverSweep"
                                                        Background="{StaticResource BorderBrush}"
                                                        CornerRadius="8"
                                                        RenderTransformOrigin="0,0.5"
                                                        IsHitTestVisible="False">

                                                    <!-- ScaleX 0 means the neutral hover background starts hidden. -->
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="0"
                                                                        ScaleY="1" />
                                                    </Border.RenderTransform>

                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <!-- Animate only when this worker can currently be purchased. -->
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsMouseOver,
                                                                                   RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                                                   Value="True" />

                                                                        <Condition Binding="{Binding IsEnabled,
                                                                                   RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                                                   Value="True" />
                                                                    </MultiDataTrigger.Conditions>

                                                                    <!-- Gradually fill the card from left to right. -->
                                                                    <MultiDataTrigger.EnterActions>
                                                                        <BeginStoryboard Storyboard="{StaticResource LeftToRightFillInStoryboard}" />
                                                                    </MultiDataTrigger.EnterActions>

                                                                    <MultiDataTrigger.ExitActions>
                                                                        <BeginStoryboard Storyboard="{StaticResource LeftToRightFillOutStoryboard}" />
                                                                    </MultiDataTrigger.ExitActions>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>

                                                <!-- Details and purchase controls for an unlocked worker. -->
                                                <Grid Margin="12">

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility"
                                                                    Value="Visible" />

                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMystery}"
                                                                             Value="True">
                                                                    <Setter Property="Visibility"
                                                                            Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>

                                                    <Image Grid.Column="0"
                                                           Source="{Binding PortraitPath}"
                                                           Width="104"
                                                           Height="104"
                                                           Margin="0,0,12,0"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                           SnapsToDevicePixels="True">

                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Visibility"
                                                                        Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding PortraitPath}"
                                                                                 Value="{x:Null}">
                                                                        <Setter Property="Visibility"
                                                                                Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>

                                                        </Image.Style>

                                                    </Image>


                                                    <StackPanel Grid.Column="1"
                                                                VerticalAlignment="Center">

                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   HorizontalAlignment="Center"
                                                                   FontSize="18"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource PrimaryTextBrush}"/>

                                                        <TextBlock Text="{Binding Description}"
                                                                   HorizontalAlignment="Center"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,4,0,12"
                                                                   Foreground="{StaticResource SecondaryTextBrush}"/>

                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Center">
                                                            <TextBlock Text="Cost: "
                                                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                                                            <TextBlock Text="{Binding CurrentCost, Converter={StaticResource CompactNumberConverter}}"
                                                                       Foreground="{StaticResource PrimaryTextBrush}"/>

                                                            <Image Source="/Assets/Icons/Currency/icon_lines_of_code.png"
                                                                   Width="20"
                                                                   Height="16"
                                                                   Margin="4,0,0,0"
                                                                   VerticalAlignment="Center" />


                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Center"
                                                                    Margin="0,4,0,4">
                                                            <TextBlock Text="Employees: "
                                                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                                                            <TextBlock Text="{Binding WorkerCount, Converter={StaticResource CompactNumberConverter}}"
                                                                       Foreground="{StaticResource PrimaryCyanBrush}"/>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Center"
                                                                    Margin="0,0,0,8">
                                                            <TextBlock Text="Current Production: "
                                                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                                                            <TextBlock Text="{Binding CurrentLinesPerSecond, Converter={StaticResource CompactNumberConverter}}"
                                                                       Foreground="{StaticResource SuccessBrush}"/>
                                                            <TextBlock Text=" Lines of Code / Second"
                                                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Limited information for the next locked worker. -->
                                                <StackPanel HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Margin="12">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility"
                                                                    Value="Collapsed" />

                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMystery}"
                                                                             Value="True">
                                                                    <Setter Property="Visibility"
                                                                            Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>

                                                    <TextBlock Text="???"
                                                               HorizontalAlignment="Center"
                                                               FontSize="26"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource SecondaryTextBrush}" />

                                                    <StackPanel Orientation="Vertical"
                                                                HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding UnlockRequirementText}"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                                   Margin="0,6,0,0" />

                                                        <TextBlock HorizontalAlignment="Center"
                                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                                   Margin="4,6,0,0">
                                                            <Run Text="Cost: " />
                                                            <Run Text="{Binding CurrentCost, Mode=OneWay, Converter={StaticResource CompactNumberConverter}}" />
                                                            <Run Text=" Lines of Code" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Statistics page -->
                    <views:StatisticsView Panel.ZIndex="1">
                        <views:StatisticsView.OpacityMask>
                            <LinearGradientBrush StartPoint="0,-0.01"
                                                 EndPoint="0,1">

                                <!--Visible area above the moving boundary-->
                                <GradientStop Color="White"
                                              Offset="0"/>
                                <GradientStop Color="White"
                                              Offset="0"/>

                                <!--Hidden area below the moving boundary-->
                                <GradientStop Color="Transparent"
                                              Offset="0"/>
                                <GradientStop Color="Transparent"
                                              Offset="1"/>

                            </LinearGradientBrush>
                        </views:StatisticsView.OpacityMask>

                        <views:StatisticsView.Style>
                            <Style TargetType="{x:Type views:StatisticsView}">
                                <Setter Property="IsHitTestVisible"
                                        Value="False" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatisticsViewVisible}"
                                                 Value="True">
                                        <Setter Property="IsHitTestVisible"
                                                Value="True" />

                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Storyboard="{StaticResource StatisticsRevealStoryboard}" />
                                        </DataTrigger.EnterActions>

                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard Storyboard="{StaticResource StatisticsRevealOutStoryboard}" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:StatisticsView.Style>
                    </views:StatisticsView>

                </Grid>
                <!-- Shared content region -->
            </Grid>
            <!-- Switchable lower area -->
        </Grid>
        <!-- Main two-row interface -->
    </Grid>
    <!-- Window root -->
</Window>
