<Window x:Class="GameStudioClicker.Wpf.Views.MainWindow"
        xmlns:views="clr-namespace:GameStudioClicker.Wpf.Views"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Game Studio Clicker"
        Icon="/Assets/Branding/AppIcon/app_icon_game_studio_clicker.png"
        Height="800"
        Width="1200"
        MinHeight="500"
        MinWidth="700"
        Background="{StaticResource GameBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="{StaticResource BodyFontFamily}">


    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header and notifications. -->
            <RowDefinition Height="Auto" />
            <!-- Main game interface. -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Optional save confirmation overlay; currently kept hidden by ViewModel usage. -->
        <Border Grid.Row="0"
                Panel.ZIndex="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Padding="10,6"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility"
                            Value="Collapsed" />

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSaveConfirmation}"
                                     Value="True">
                            <Setter Property="Visibility"
                                    Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <TextBlock Text="Game Saved!"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource SuccessBrush}" />
        </Border>

        <!-- Main two-column game layout. -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <!-- Production summary. -->
                <RowDefinition Height="Auto" />
                <!-- Progression content. -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Compact production and active-upgrade dashboard. -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <!-- Game identity -->
                    <ColumnDefinition Width="*" />

                    <!-- Main game action -->
                    <ColumnDefinition Width="*" />

                    <!-- Active upgrades -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="/Assets/Branding/Logo/logo_game_studio_clicker.png"
                       MaxWidth="300"
                       MaxHeight="150"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,0,0,4"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       SnapsToDevicePixels="True" />

                <!-- Manual coding and current production. -->
                <Border Grid.Column="1"
                        Width="280"
                        HorizontalAlignment="Center"
                        Padding="10"
                        BorderThickness="1"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        CornerRadius="8">

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <!-- Current resource total. -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <Image Source="/Assets/Icons/Currency/icon_lines_of_code.png"
                                   Width="42"
                                   Height="42"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   SnapsToDevicePixels="True"/>

                            <TextBlock Text="{Binding LinesOfCode,
                                       Converter={StaticResource CompactNumberConverter}}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                        <!-- Main click action and floating +X feedback. -->
                        <Grid x:Name="ClickFeedbackLayer"
                              Height="70"
                              Margin="0,4,0,4"
                              ClipToBounds="False">
                            <Button Content="Write Code"
                                    Width="150"
                                    Height="50"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Command="{Binding WriteCodeCommand}"
                                    Click="WriteCodeButton_Click"
                                    Style="{StaticResource PrimaryActionButtonStyle}" />
                        </Grid>

                        <!-- Passive production. -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="{Binding LinesPerSecond,
                                       Converter={StaticResource CompactNumberConverter}}"
                                       FontSize="16"
                                       FontWeight="SemiBold" />

                            <TextBlock Text=" Lines / second"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Notifications and active upgrades share the right dashboard column. -->
                <Grid Grid.Column="2"
                      Margin="24,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Temporary message shown when offline progress is applied. -->
                    <Border Grid.Row="0"
                            MaxWidth="360"
                            Padding="10,8"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Center"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Opacity="0">

                        <Border.RenderTransform>
                            <TranslateTransform X="16" />
                        </Border.RenderTransform>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Hidden" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasOfflineEarnings}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Storyboard="{StaticResource OfflineEarningsStoryboard}" />
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <TextBlock Text="{Binding OfflineEarningsMessage}"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />
                    </Border>

                    <!-- Active upgrades. -->
                    <views:ActiveUpgradesView Grid.Row="1"
                                              Margin="0,8,0,0"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Bottom"/>
                </Grid>
            </Grid>

            <!-- Switchable Workers and Statistics area. -->
            <Grid Grid.Row="1"
                  Margin="0,16,0,0">

                <Grid.RowDefinitions>
                    <!-- Page navigation -->
                    <RowDefinition Height="Auto" />

                    <!-- Selected page -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0"
                        Content="Statistics"
                        HorizontalAlignment="Right"
                        Command="{Binding ToggleStatisticsCommand}"
                        ToolTip="Show or hide statistics">

                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Setter Property="Margin"
                                    Value="4" />

                            <Style.Triggers>
                                <!-- Highlight the buttons while statics is open -->
                                <DataTrigger Binding="{Binding IsStatisticsViewVisible}"
                                             Value="True">
                                    <Setter Property="Background"
                                            Value="{StaticResource BorderBrush}" />
                                    <Setter Property="BorderBrush"
                                            Value="{StaticResource PrimaryCyanBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Both Worker and Statistics occupy this same region. -->
                <Grid Grid.Row="1"
                      Margin="0,12,0,0"
                      ClipToBounds="False">

                    <!-- Worker page -->
                    <views:WorkerUpgradesView/>

                    <!-- Statistics page -->
                    <views:StatisticsView Panel.ZIndex="1">
                        <views:StatisticsView.OpacityMask>
                            <LinearGradientBrush StartPoint="0,-0.01"
                                                 EndPoint="0,1">

                                <!--Visible area above the moving boundary-->
                                <GradientStop Color="White"
                                              Offset="0"/>
                                <GradientStop Color="White"
                                              Offset="0"/>

                                <!--Hidden area below the moving boundary-->
                                <GradientStop Color="Transparent"
                                              Offset="0"/>
                                <GradientStop Color="Transparent"
                                              Offset="1"/>

                            </LinearGradientBrush>
                        </views:StatisticsView.OpacityMask>

                        <views:StatisticsView.Style>
                            <Style TargetType="{x:Type views:StatisticsView}">
                                <Setter Property="IsHitTestVisible"
                                        Value="False" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatisticsViewVisible}"
                                                 Value="True">
                                        <Setter Property="IsHitTestVisible"
                                                Value="True" />

                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Storyboard="{StaticResource StatisticsRevealStoryboard}" />
                                        </DataTrigger.EnterActions>

                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard Storyboard="{StaticResource StatisticsRevealOutStoryboard}" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:StatisticsView.Style>
                    </views:StatisticsView>

                </Grid>
                <!-- Shared content region -->
            </Grid>
            <!-- Switchable lower area -->
        </Grid>
        <!-- Main two-row interface -->
    </Grid>
    <!-- Window root -->
</Window>
