<Window x:Class="GameStudioClicker.Wpf.Views.MainWindow"
        xmlns:views="clr-namespace:GameStudioClicker.Wpf.Views"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Game Studio Clicker"
        Icon="/Assets/Branding/AppIcon/app_icon_game_studio_clicker.png"
        Height="800"
        Width="1280"
        MinHeight="800"
        MinWidth="1280"

        Background="{StaticResource GameBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="{StaticResource BodyFontFamily}">


    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header and notifications. -->
            <RowDefinition Height="Auto" />
            <!-- Main game interface. -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Optional save confirmation overlay; currently kept hidden by ViewModel usage. -->
        <Border Grid.Row="0"
                Panel.ZIndex="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Padding="10,6"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility"
                            Value="Collapsed" />

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSaveConfirmation}"
                                     Value="True">
                            <Setter Property="Visibility"
                                    Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <TextBlock Text="Game Saved!"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource SuccessBrush}" />
        </Border>

        <!-- Achievement notification overlay. -->
        <Border Grid.RowSpan="2"
                Panel.ZIndex="10"
                Width="360"
                Margin="0,0,8,8"
                Padding="14"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                IsHitTestVisible="False"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource WarningBrush}"
                BorderThickness="2"
                CornerRadius="8">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Visibility"
                            Value="Collapsed"/>

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasAchievementNotification}"
                                     Value="True">
                            <Setter Property="Visibility"
                                    Value="Visible"/>

                            <DataTrigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource AchievementNotificationStoryboard}"/>
                            </DataTrigger.EnterActions>
                            
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Border.RenderTransform>
                <TranslateTransform/>
            </Border.RenderTransform>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Width="44"
                       Height="44"
                       VerticalAlignment="Center"
                       Source="/Assets/Icons/Navigation/icon_achievements.png"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                <StackPanel Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="ACHIEVEMENT UNLOCKED"
                               FontFamily="{StaticResource DisplayFontFamily}"
                               FontSize="9"
                               Foreground="{StaticResource WarningBrush}"/>

                    <TextBlock Text="{Binding AchievementNotificationName}"
                               Margin="0,7,0,3"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="{Binding AchievementNotificationDescription}"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap"/>

                </StackPanel>

            </Grid>
        </Border>

        <!-- Main two-column game layout. -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <!-- Production summary. -->
                <RowDefinition Height="Auto" />
                <!-- Progression content. -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Compact production and active-upgrade dashboard. -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <!-- Game identity -->
                    <ColumnDefinition Width="*" />

                    <!-- Main game action -->
                    <ColumnDefinition Width="*" />

                    <!-- Active upgrades -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="/Assets/Branding/Logo/logo_game_studio_clicker.png"

                       MaxWidth="450"
                       MaxHeight="250"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,0,0,4"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       SnapsToDevicePixels="True" />

                <!-- Manual coding and current production. -->
                <Border Grid.Column="1"
                        Width="350"
                        HorizontalAlignment="Center"
                        Padding="10"
                        BorderThickness="1"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        CornerRadius="8">

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <!-- Current resource total. -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <Image Source="/Assets/Icons/Currency/icon_lines_of_code.png"
                                   Width="42"
                                   Height="42"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   SnapsToDevicePixels="True"/>

                            <TextBlock Text="{Binding LinesOfCode,
                                       Converter={StaticResource CompactNumberConverter}}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                        <!-- Main click action and floating +X feedback. -->
                        <Grid x:Name="ClickFeedbackLayer"
                              Height="70"
                              Margin="0,4,0,4"
                              ClipToBounds="False">
                            <Button Content="Write Code"
                                    Width="150"
                                    Height="50"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Command="{Binding WriteCodeCommand}"
                                    Click="WriteCodeButton_Click"
                                    Style="{StaticResource PrimaryActionButtonStyle}" />
                        </Grid>

                        <!-- Passive production. -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="{Binding LinesPerSecond,
                                       Converter={StaticResource CompactNumberConverter}}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>

                            <Image Source="/Assets/Icons/Currency/icon_lines_of_code.png"
                                   Width="24"
                                   Height="24"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Margin="6,0,4,0"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   SnapsToDevicePixels="True"/>

                            <TextBlock Text="/ second"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Notifications and active upgrades share the right dashboard column. -->
                <Grid Grid.Column="2"
                      Margin="24,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Temporary message shown when offline progress is applied. -->
                    <Border Grid.Row="0"
                            MaxWidth="360"
                            Padding="10,8"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Center"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Opacity="0">

                        <Border.RenderTransform>
                            <TranslateTransform X="16" />
                        </Border.RenderTransform>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Hidden" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasOfflineEarnings}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Storyboard="{StaticResource OfflineEarningsStoryboard}" />
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <TextBlock Text="{Binding OfflineEarningsMessage}"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />
                    </Border>

                    <!-- Active upgrades. -->
                    <views:ActiveUpgradesView Grid.Row="1"
                                              Margin="0,8,0,0"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Bottom"/>
                </Grid>
            </Grid>

            <!-- Switchable navigation area. -->
            <Grid Grid.Row="1"
                  Margin="0,16,0,0">

                <Grid.RowDefinitions>
                    <!-- Page navigation -->
                    <RowDefinition Height="Auto" />

                    <!-- Selected page -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <!-- Statistics navigation -->
                    <Button Command="{Binding ToggleStatisticsCommand}"
                            ToolTip="Show or hide statistics">

                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource PrimaryButtonStyle}">
                                <Setter Property="Margin"
                                        Value="4" />
                                <Setter Property="Width"
                                        Value="52" />
                                <Setter Property="Height"
                                        Value="52" />
                                <Setter Property="Padding"
                                        Value="6" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatisticsViewVisible}"
                                                 Value="True">
                                        <Setter Property="Background"
                                                Value="{StaticResource BorderBrush}" />
                                        <Setter Property="BorderBrush"
                                                Value="{StaticResource PrimaryCyanBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>


                        <Image Source="/Assets/Icons/Navigation/icon_statistics.png"
                               Width="40"
                               Height="40"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />

                    </Button>

                    <!-- Achievements navigation -->
                    <Button Command="{Binding ToggleAchievementsCommand}"
                            ToolTip="Show or hide achievements">

                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource AchievementButtonStyle}">
                                <Setter Property="Margin"
                                        Value="4" />
                                <Setter Property="Width"
                                        Value="52" />
                                <Setter Property="Height"
                                        Value="52" />
                                <Setter Property="Padding"
                                        Value="6" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAchievementsViewVisible}"
                                                 Value="True">
                                        <Setter Property="Background"
                                                Value="{StaticResource BorderBrush}" />
                                        <Setter Property="BorderBrush"
                                                Value="{StaticResource WarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>

                        <Image Source="/Assets/Icons/Navigation/icon_achievements.png"
                               Width="40"
                               Height="40"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />

                    </Button>
                </StackPanel>

                <!-- All navigation views occupy this same region. -->
                <Grid Grid.Row="1"
                      Margin="0,12,0,0"
                      ClipToBounds="False">

                    <!-- Worker page -->
                    <views:WorkerUpgradesView/>

                    <!-- Statistics page -->
                    <views:StatisticsView Panel.ZIndex="1">
                        <views:StatisticsView.OpacityMask>
                            <LinearGradientBrush StartPoint="0,-0.01"
                                                 EndPoint="0,1">

                                <!--Visible area above the moving boundary-->
                                <GradientStop Color="White"
                                              Offset="0"/>
                                <GradientStop Color="White"
                                              Offset="0"/>

                                <!--Hidden area below the moving boundary-->
                                <GradientStop Color="Transparent"
                                              Offset="0"/>
                                <GradientStop Color="Transparent"
                                              Offset="1"/>

                            </LinearGradientBrush>
                        </views:StatisticsView.OpacityMask>

                        <views:StatisticsView.Style>
                            <Style TargetType="{x:Type views:StatisticsView}">
                                <Setter Property="IsHitTestVisible"
                                        Value="False" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatisticsViewVisible}"
                                                 Value="True">
                                        <Setter Property="IsHitTestVisible"
                                                Value="True" />

                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Storyboard="{StaticResource PageRevealStoryboard}" />
                                        </DataTrigger.EnterActions>

                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard Storyboard="{StaticResource PageRevealOutStoryboard}" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:StatisticsView.Style>
                    </views:StatisticsView>

                    <!-- Achievements page -->
                    <views:AchievementsView Panel.ZIndex="2">
                        <views:AchievementsView.OpacityMask>
                            <LinearGradientBrush StartPoint="0,-0.01"
                                                 EndPoint="0,1">

                                <!-- Visible area above the moving boundary -->
                                <GradientStop Color="White"
                                              Offset="0" />
                                <GradientStop Color="White"
                                              Offset="0" />

                                <!-- Hidden area below the moving boundary -->
                                <GradientStop Color="Transparent"
                                              Offset="0" />
                                <GradientStop Color="Transparent"
                                              Offset="1" />
                            </LinearGradientBrush>
                        </views:AchievementsView.OpacityMask>

                        <views:AchievementsView.Style>
                            <Style TargetType="{x:Type views:AchievementsView}">
                                <Setter Property="IsHitTestVisible"
                                        Value="False" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAchievementsViewVisible}"
                                                 Value="True">
                                        <Setter Property="IsHitTestVisible"
                                                Value="True" />

                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Storyboard="{StaticResource PageRevealStoryboard}" />
                                        </DataTrigger.EnterActions>

                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard Storyboard="{StaticResource PageRevealOutStoryboard}" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:AchievementsView.Style>
                    </views:AchievementsView>

                </Grid>
                <!-- Shared content region -->
            </Grid>
            <!-- Switchable lower area -->
        </Grid>
        <!-- Main two-row interface -->
    </Grid>
    <!-- Window root -->
</Window>
