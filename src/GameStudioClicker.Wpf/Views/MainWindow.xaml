<Window x:Class="GameStudioClicker.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Game Studio Clicker"
        Height="800"
        Width="1200"
        MinHeight="500"
        MinWidth="700"
        Background="#18181B"
        Foreground="#F4F4F5">

    <Window.Resources>
        <!-- Shared appearance and interaction states for clickable game actions. -->
        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">
            <Setter Property="Background" Value="#3F3F46" />
            <Setter Property="Foreground" Value="#F4F4F5" />
            <Setter Property="BorderBrush" Value="#52525B" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <!-- Visual states belong to the reusable button template. -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#45454B" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#38383E" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#303034" />
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#38383E" />
                                <Setter Property="Foreground"
                                        Value="#777780" />
                                <Setter Property="Cursor"
                                        Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Global tooltip appearance used by active-upgrade details. -->
        <Style TargetType="{x:Type ToolTip}">
            <Setter Property="Background"
                    Value="#27272A" />
            <Setter Property="Foreground"
                    Value="#F4F4F5" />
            <Setter Property="BorderBrush"
                    Value="#52525B" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Padding"
                    Value="12" />
            <Setter Property="Placement"
                    Value="Bottom" />
            <Setter Property="HasDropShadow"
                    Value="True" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToolTip}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header and notifications. -->
            <RowDefinition Height="Auto" />
            <!-- Main game interface. -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Optional save confirmation overlay; currently kept hidden by ViewModel usage. -->
        <Border Grid.Row="0"
                Panel.ZIndex="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Padding="10,6"
                Background="#27272A"
                BorderBrush="#3F3F46"
                BorderThickness="1"
                CornerRadius="6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility"
                            Value="Collapsed" />

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSaveConfirmation}"
                                     Value="True">
                            <Setter Property="Visibility"
                                    Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <TextBlock Text="Game Saved!"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#86EFAC" />
        </Border>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <!-- Game title -->
            <TextBlock Text="Game Studio Clicker!"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       FontSize="45"
                       FontWeight="Bold"
                       Margin="0,20,0,10" />

            <!-- Temporary message shown when offline progress is applied. -->
            <Border Padding="12"
                    Margin="0,0,0,16"
                    HorizontalAlignment="Center"
                    Background="#2F2F33"
                    BorderBrush="#45454B"
                    BorderThickness="1"
                    CornerRadius="6">

                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasOfflineEarnings}"
                                         Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <TextBlock Text="{Binding OfflineEarningsMessage}"
                           Foreground="#D4D4D8"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
            </Border>
        </StackPanel>

        <!-- Main two-column game layout -->
        <Grid Grid.Row="1" Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <!-- Manual production and totals. -->
                <ColumnDefinition Width="2*" />
                <!-- Purchasable upgrades and workers. -->
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- Manual coding and current production -->
            <Border Grid.Column="0"
                    Padding="10"
                    BorderThickness="1"
                    Background="#27272A"
                    BorderBrush="#3F3F46"
                    CornerRadius="8">
                <StackPanel>
                    <!-- Current resource total -->
                    <StackPanel Orientation="Vertical"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,10">
                        <TextBlock Text="Lines of Code Written: "
                                   FontSize="24"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding LinesOfCode,
                                          Converter={StaticResource CompactNumberConverter}}"
                                   FontSize="24"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Button surface also hosts temporary +X visuals created in code-behind. -->
                    <Grid x:Name="ClickFeedbackLayer">
                        <Button Content="Write Code"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="150"
                                Height="50"
                                FontSize="16"
                                Command="{Binding WriteCodeCommand}"
                                Click="WriteCodeButton_Click"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>

                    <!-- Current production summary -->
                    <TextBlock Text="Current Production"
                               HorizontalAlignment="Center"
                               FontSize="24"
                               FontWeight="Bold"
                               Margin="0,30,0,10" />

                    <StackPanel Orientation="Vertical"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,10">
                        <TextBlock Text="Lines of Code / Click: "
                                   FontSize="16"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding LinesPerClick, Converter={StaticResource CompactNumberConverter}}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical"
                                HorizontalAlignment="Center">
                        <TextBlock Text="Lines of Code / Second: "
                                   FontSize="16"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding LinesPerSecond, Converter={StaticResource CompactNumberConverter}}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Scrollable progression area -->
            <ScrollViewer Grid.Column="1"
                          Margin="24,0,0,0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Compact, one-time active upgrades -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Active Upgrades"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8" />

                        <ItemsControl ItemsSource="{Binding ActiveUpgrades}">
                            <!-- Arrange compact upgrade buttons from left to right. -->
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- One active-upgrade button -->
                                    <Button Width="60"
                                            Height="60"
                                            Margin="4,4,8,8"
                                            Padding="4"
                                            ToolTipService.InitialShowDelay="150"
                                            ToolTipService.BetweenShowDelay="0"
                                            ToolTipService.ShowDuration="30000"
                                            ToolTipService.ShowOnDisabled="True"
                                            RenderTransformOrigin="0.5,0.5"
                                            Command="{Binding DataContext.PurchaseActiveUpgradeCommand,
                                                              RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                            CommandParameter="{Binding}">

                                        <!-- Used by the one-time affordability pulse. -->
                                        <Button.RenderTransform>
                                            <ScaleTransform ScaleX="1"
                                                            ScaleY="1" />
                                        </Button.RenderTransform>

                                        <Button.Style>
                                            <Style TargetType="Button"
                                                   BasedOn="{StaticResource PrimaryButtonStyle}">
                                                <Setter Property="Visibility"
                                                        Value="Visible" />

                                                <Style.Triggers>
                                                    <!-- Purchased or distant upgrades are removed by the ViewModel. -->
                                                    <DataTrigger Binding="{Binding IsVisible}"
                                                                 Value="False">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                    </DataTrigger>

                                                    <!-- Pulse once when a visible upgrade becomes purchasable. -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsVisible}"
                                                                       Value="True" />
                                                            <Condition Binding="{Binding CanPurchaseActiveUpgrade}"
                                                                       Value="True" />
                                                        </MultiDataTrigger.Conditions>

                                                        <MultiDataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                        From="1"
                                                                        To="1.12"
                                                                        Duration="0:0:0.15"
                                                                        AutoReverse="True"
                                                                        FillBehavior="Stop" />

                                                                    <DoubleAnimation
                                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                        From="1"
                                                                        To="1.12"
                                                                        Duration="0:0:0.15"
                                                                        AutoReverse="True"
                                                                        FillBehavior="Stop" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </MultiDataTrigger.EnterActions>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>

                                        <!-- Temporary generic upgrade icon -->
                                        <TextBlock Text="↑"
                                                   FontSize="24"
                                                   FontWeight="Bold" />

                                        <Button.ToolTip>
                                            <ToolTip DataContext="{Binding PlacementTarget.DataContext,
                                                                            RelativeSource={RelativeSource Self}}">
                                                <StackPanel MaxWidth="260">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="16"
                                                               FontWeight="Bold"
                                                               Margin="0,0,0,6" />

                                                    <TextBlock Text="{Binding Description}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,0,0,8" />

                                                    <TextBlock FontWeight="SemiBold">
                                                        <Run Text="Cost: " />
                                                        <Run Text="{Binding Cost, Mode=OneWay, Converter={StaticResource CompactNumberConverter}}" />
                                                        <Run Text=" Lines of Code" />
                                                    </TextBlock>

                                                    <!-- Only visible while an upgrade or worker requirement is unmet. -->
                                                    <TextBlock Text="{Binding RequirementText}"
                                                               Foreground="#FCA5A5"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               Margin="0,8,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility"
                                                                        Value="Collapsed" />

                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasUnmetRequirement}"
                                                                                 Value="True">
                                                                        <Setter Property="Visibility"
                                                                                Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Repeatable worker upgrades -->
                    <ItemsControl ItemsSource="{Binding WorkerUpgrades}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- One worker card, shown either unlocked or as a mystery preview. -->
                                <Border x:Name="WorkerCard"
                                        Padding="12"
                                        Margin="0,0,0,12"
                                        BorderBrush="#3F3F46"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Height="190">

                                    <Border.Background>
                                        <!-- Explicit brush enables the purchase color animation. -->
                                        <SolidColorBrush Color="#27272A" />
                                    </Border.Background>

                                    <!-- Brief confirmation flash when the Hire button succeeds. -->
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Button.Click">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation
                                                        Storyboard.TargetName="WorkerCard"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        From="#27272A"
                                                        To="#2D3330"
                                                        Duration="0:0:0.1"
                                                        AutoReverse="True"
                                                        FillBehavior="Stop" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>

                                    <!-- Hide worker types that are too far ahead in progression. -->
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility"
                                                    Value="Visible" />

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsVisible}"
                                                             Value="False">
                                                    <Setter Property="Visibility"
                                                            Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <!-- Details and purchase controls for an unlocked worker. -->
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility"
                                                            Value="Visible" />

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMystery}"
                                                                     Value="True">
                                                            <Setter Property="Visibility"
                                                                    Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <TextBlock Text="{Binding DisplayName}"
                                                       HorizontalAlignment="Center"
                                                       FontSize="18"
                                                       FontWeight="Bold" />

                                            <TextBlock Text="{Binding Description}"
                                                       HorizontalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,12" />

                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center">
                                                <TextBlock Text="Cost: " />
                                                <TextBlock Text="{Binding CurrentCost, Converter={StaticResource CompactNumberConverter}}" />
                                                <TextBlock Text=" Lines of Code" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,4,0,4">
                                                <TextBlock Text="Employees: " />
                                                <TextBlock Text="{Binding WorkerCount, Converter={StaticResource CompactNumberConverter}}" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,0,0,8">
                                                <TextBlock Text="Current Production: " />
                                                <TextBlock Text="{Binding CurrentLinesPerSecond, Converter={StaticResource CompactNumberConverter}}" />
                                                <TextBlock Text=" Lines of Code / Second" />
                                            </StackPanel>

                                            <Button Content="Hire"
                                                    Width="200"
                                                    Height="40"
                                                    HorizontalAlignment="Center"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Command="{Binding DataContext.PurchaseWorkerUpgradeCommand,
                                                                      RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>

                                        <!-- Limited information for the next locked worker. -->
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Margin="0,12">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility"
                                                            Value="Collapsed" />

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMystery}"
                                                                     Value="True">
                                                            <Setter Property="Visibility"
                                                                    Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <TextBlock Text="???"
                                                       HorizontalAlignment="Center"
                                                       FontSize="26"
                                                       FontWeight="Bold"
                                                       Foreground="#A1A1AA" />

                                            <StackPanel Orientation="Vertical"
                                                        HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding UnlockRequirementText}"
                                                           HorizontalAlignment="Center"
                                                           Foreground="#71717A"
                                                           Margin="0,6,0,0" />

                                                <TextBlock HorizontalAlignment="Center"
                                                           Foreground="#71717A"
                                                           Margin="4,6,0,0">
                                                    <Run Text="Cost: " />
                                                    <Run Text="{Binding CurrentCost, Mode=OneWay, Converter={StaticResource CompactNumberConverter}}" />
                                                    <Run Text=" Lines of Code" />
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
