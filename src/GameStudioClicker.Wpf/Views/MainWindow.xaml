<Window x:Class="GameStudioClicker.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Game Studio Clicker"
        Height="450"
        Width="800">
    <Grid>
        <StackPanel Orientation="Vertical">
            <TextBlock Text="Welcome to Game Studio Clicker!"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,20,0,20" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,10">
                <TextBlock Text="Lines of Code Written: "
                           FontSize="16" />
                <TextBlock Text="{Binding LinesOfCode}"
                           FontSize="16" />
            </StackPanel>

            <Button Content="Write Code"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="150"
                    Height="50"
                    FontSize="16"
                    Command="{Binding WriteCodeCommand}" />

            <TextBlock Text="Current Production"
                       HorizontalAlignment="Center"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,30,0,5" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <TextBlock Text="Lines of code per click: " />
                <TextBlock Text="{Binding LinesPerClick}" />
            </StackPanel>

            <TextBlock Text="Mechanical Keyboard"
                       HorizontalAlignment="Center"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,25,0,5" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <TextBlock Text="Cost: " />
                <TextBlock Text="{Binding MechanicalKeyboardCost}" />
                <TextBlock Text=" Lines of Code" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,5,0,10">
                <TextBlock Text="Owned: " />
                <TextBlock Text="{Binding MechanicalKeyboardCount}" />
            </StackPanel>

            <Button Content="Buy Mechanical Keyboard"
                    HorizontalAlignment="Center"
                    Width="200"
                    Height="40"
                    Command="{Binding PurchaseMechanicalKeyboardCommand}" />
        </StackPanel>
    </Grid>
</Window>
