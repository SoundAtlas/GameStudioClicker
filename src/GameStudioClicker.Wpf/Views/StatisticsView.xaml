<UserControl x:Class="GameStudioClicker.Wpf.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GameStudioClicker.Wpf.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Border CornerRadius="8"
                Margin="1"
                Padding="1"
                SnapsToDevicePixels="True"
                Background="{StaticResource GameBackgroundBrush}">


            <!-- The page can grow vertically when achievements are added later. -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel Margin="12">
                    <!-- Page heading -->
                    <TextBlock Text="Statistics"
                               Style="{StaticResource SectionHeadingTextStyle}"
                               Margin="0,0,0,16" />

                    <!-- Lifetime statistics -->
                    <Border Padding="18"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Lifetime Lines of Code"
                                       VerticalAlignment="Center"
                                       FontSize="17"
                                       FontWeight="SemiBold" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding LifetimeLinesOfCode,
                                       Converter={StaticResource CompactNumberConverter}}"
                                       Margin="24,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryCyanBrush}" />
                        </Grid>
                    </Border>

                    <!-- Future achievement content will go below the statistics cards. -->
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
