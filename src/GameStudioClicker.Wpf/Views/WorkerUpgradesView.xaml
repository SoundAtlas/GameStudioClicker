<UserControl x:Class="GameStudioClicker.Wpf.Views.WorkerUpgradesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GameStudioClicker.Wpf.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">

        <!-- Repeatable worker upgrades. -->
        <ItemsControl ItemsSource="{Binding WorkerUpgrades}"
                      VerticalAlignment="Top">
            <!-- Keep worker cards in two equal-width columns. -->
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- The whole worker card purchases the represented worker. -->
                    <Button Height="150"
                            Margin="6"
                            RenderTransformOrigin="0.5,0.5"
                            Command="{Binding DataContext.PurchaseWorkerUpgradeCommand,
                            RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{Binding}">

                        <Button.RenderTransform>
                            <ScaleTransform ScaleX="1"
                                            ScaleY="1" />
                        </Button.RenderTransform>

                        <!-- Hidden future workers do not show an empty card. -->
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource WorkerCardButtonStyle}">
                                <Setter Property="Visibility"
                                        Value="Visible" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVisible}"
                                                 Value="False">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                    </DataTrigger>

                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver"
                                                       Value="True" />

                                            <Condition Property="IsEnabled"
                                                       Value="True" />

                                        </MultiTrigger.Conditions>

                                        <MultiTrigger.EnterActions>
                                            <BeginStoryboard Storyboard="{StaticResource SubtleHoverScaleInStoryboard}" />
                                        </MultiTrigger.EnterActions>

                                        <MultiTrigger.ExitActions>
                                            <BeginStoryboard Storyboard="{StaticResource SubtleHoverScaleOutStoryboard}" />
                                        </MultiTrigger.ExitActions>
                                    </MultiTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>

                        <!-- Brief confirmation flash after a successful purchase. -->
                        <Button.Triggers>
                            <EventTrigger RoutedEvent="Button.Click">
                                <BeginStoryboard Storyboard="{StaticResource WorkerCardPurchaseFlashStoryboard}" />
                            </EventTrigger>
                        </Button.Triggers>

                        <!-- Card contents are retained while the surrounding button handles hiring. -->
                        <Border x:Name="WorkerCard"
                                Padding="0"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">

                            <Border.Background>
                                <!-- Explicit brush enables the purchase color animation. -->
                                <SolidColorBrush Color="{StaticResource SurfaceColor}" />
                            </Border.Background>

                            <Grid>
                                <Border x:Name="HoverSweep"
                                        Background="{StaticResource BorderBrush}"
                                        CornerRadius="8"
                                        RenderTransformOrigin="0,0.5"
                                        IsHitTestVisible="False">

                                    <!-- ScaleX 0 means the neutral hover background starts hidden. -->
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="0"
                                                        ScaleY="1" />
                                    </Border.RenderTransform>

                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <!-- Animate only when this worker can currently be purchased. -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMouseOver,
                                                                   RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                                   Value="True" />

                                                        <Condition Binding="{Binding IsEnabled,
                                                                   RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                                   Value="True" />
                                                    </MultiDataTrigger.Conditions>

                                                    <!-- Gradually fill the card from left to right. -->
                                                    <MultiDataTrigger.EnterActions>
                                                        <BeginStoryboard Storyboard="{StaticResource LeftToRightFillInStoryboard}" />
                                                    </MultiDataTrigger.EnterActions>

                                                    <MultiDataTrigger.ExitActions>
                                                        <BeginStoryboard Storyboard="{StaticResource LeftToRightFillOutStoryboard}" />
                                                    </MultiDataTrigger.ExitActions>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <!-- Purchase feedback displayed above the hover sweep. -->
                                <Border x:Name="PurchaseFlashOverlay"
                                        CornerRadius="8"
                                        IsHitTestVisible="False">
                                    <Border.Background>
                                        <SolidColorBrush
                                            Color="{StaticResource TransparentSuccessFlashColor}" />
                                    </Border.Background>
                                </Border>

                                <!-- Details and purchase controls for an unlocked worker. -->
                                <Grid Margin="12">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility"
                                                    Value="Visible" />

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMystery}"
                                                             Value="True">
                                                    <Setter Property="Visibility"
                                                            Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <Image Grid.Column="0"
                                           Source="{Binding PortraitPath}"
                                           Width="104"
                                           Height="104"
                                           Margin="0,0,12,0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           SnapsToDevicePixels="True">

                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility"
                                                        Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PortraitPath}"
                                                                 Value="{x:Null}">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>

                                        </Image.Style>

                                    </Image>


                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="{Binding DisplayName}"
                                                   HorizontalAlignment="Center"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryTextBrush}"/>

                                        <TextBlock Text="{Binding Description}"
                                                   HorizontalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,12"
                                                   Foreground="{StaticResource SecondaryTextBrush}"/>

                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center">
                                            <TextBlock Text="Cost: "
                                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <TextBlock Text="{Binding CurrentCost, Converter={StaticResource CompactNumberConverter}}"
                                                       Foreground="{StaticResource PrimaryTextBrush}"/>

                                            <Image Source="/Assets/Icons/Currency/icon_lines_of_code.png"
                                                   Width="20"
                                                   Height="16"
                                                   Margin="4,0,0,0"
                                                   VerticalAlignment="Center" />


                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,4,0,4">
                                            <TextBlock Text="Employees: "
                                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <TextBlock Text="{Binding WorkerCount, Converter={StaticResource CompactNumberConverter}}"
                                                       Foreground="{StaticResource PrimaryCyanBrush}"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,0,8">
                                            <TextBlock Text="Current Production: "
                                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <TextBlock Text="{Binding CurrentLinesPerSecond, Converter={StaticResource CompactNumberConverter}}"
                                                       Foreground="{StaticResource SuccessBrush}"/>
                                            <TextBlock Text=" Lines of Code / Second"
                                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Limited information for the next locked worker. -->
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="12">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMystery}"
                                                             Value="True">
                                                    <Setter Property="Visibility"
                                                            Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <TextBlock Text="???"
                                               HorizontalAlignment="Center"
                                               FontSize="26"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource SecondaryTextBrush}" />

                                    <StackPanel Orientation="Vertical"
                                                HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding UnlockRequirementText}"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   Margin="0,6,0,0" />

                                        <TextBlock HorizontalAlignment="Center"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   Margin="4,6,0,0">
                                            <Run Text="Cost: " />
                                            <Run Text="{Binding CurrentCost, Mode=OneWay, Converter={StaticResource CompactNumberConverter}}" />
                                            <Run Text=" Lines of Code" />
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
