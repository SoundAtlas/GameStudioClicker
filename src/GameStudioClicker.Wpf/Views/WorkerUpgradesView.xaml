<UserControl x:Class="GameStudioClicker.Wpf.Views.WorkerUpgradesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GameStudioClicker.Wpf.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">

        <!-- Repeatable worker upgrades. -->
        <ItemsControl ItemsSource="{Binding WorkerUpgrades}"
                      Width="1176"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top">
            <!-- Keep worker cards in three equal-width columns. -->
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- The whole worker card purchases the represented worker. -->
                    <Button Height="110"
                            Width="380"
                            Margin="6"
                            ToolTipService.ShowOnDisabled="True"
                            ToolTipService.InitialShowDelay="150"
                            RenderTransformOrigin="0.5,0.5"
                            Command="{Binding DataContext.PurchaseWorkerUpgradeCommand,
                            RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{Binding}">

                        <Button.RenderTransform>
                            <ScaleTransform ScaleX="1"
                                            ScaleY="1" />
                        </Button.RenderTransform>

                        <!-- Hidden future workers do not show an empty card. -->
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource WorkerCardButtonStyle}">
                                <Setter Property="Visibility"
                                        Value="Visible" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVisible}"
                                                 Value="False">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                    </DataTrigger>

                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver"
                                                       Value="True" />

                                            <Condition Property="IsEnabled"
                                                       Value="True" />

                                        </MultiTrigger.Conditions>

                                        <MultiTrigger.EnterActions>
                                            <BeginStoryboard Storyboard="{StaticResource SubtleHoverScaleInStoryboard}" />
                                        </MultiTrigger.EnterActions>

                                        <MultiTrigger.ExitActions>
                                            <BeginStoryboard Storyboard="{StaticResource SubtleHoverScaleOutStoryboard}" />
                                        </MultiTrigger.ExitActions>
                                    </MultiTrigger>

                                    <DataTrigger Binding="{Binding IsMystery}"
                                                 Value="True">
                                        <Setter Property="ToolTipService.IsEnabled"
                                                Value="False" />
                                    </DataTrigger>

                                </Style.Triggers>
                            </Style>
                        </Button.Style>

                        <!-- Brief confirmation flash after a successful purchase. -->
                        <Button.Triggers>
                            <EventTrigger RoutedEvent="Button.Click">
                                <BeginStoryboard Storyboard="{StaticResource WorkerCardPurchaseFlashStoryboard}" />
                            </EventTrigger>
                        </Button.Triggers>


                        <Button.ToolTip>
                            <ToolTip>
                                <StackPanel MinWidth="210">
                                    <TextBlock Text="{Binding DisplayName}"
                                               Margin="0,0,0,8"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryTextBrush}" />

                                    <TextBlock Margin="0,0,0,4"
                                               Foreground="{StaticResource SecondaryTextBrush}">
                                        <Run Text="Each employee: " />
                                        <Run Text="+"
                                             Foreground="{StaticResource SuccessBrush}" />
                                        <Run Text="{Binding LinesPerSecondPerEmployee,
                                             Mode=OneWay,
                                             Converter={StaticResource CompactNumberConverter}}"
                                             Foreground="{StaticResource SuccessBrush}" />
                                        <Run Text=" / sec" />
                                    </TextBlock>

                                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}">
                                        <Run Text="Current total: " />
                                        <Run Text="+"
                                             Foreground="{StaticResource SuccessBrush}" />
                                        <Run Text="{Binding CurrentLinesPerSecond,
                                             Mode=OneWay,
                                             Converter={StaticResource CompactNumberConverter}}"
                                             Foreground="{StaticResource SuccessBrush}" />
                                        <Run Text=" / sec" />
                                    </TextBlock>

                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>

                        <!-- Card contents are retained while the surrounding button handles hiring. -->
                        <Border x:Name="WorkerCard"
                                Padding="0"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">

                            <Border.Background>
                                <!-- Explicit brush enables the purchase color animation. -->
                                <SolidColorBrush Color="{StaticResource SurfaceColor}" />
                            </Border.Background>

                            <Grid>
                                <Border x:Name="HoverSweep"
                                        Background="{StaticResource BorderBrush}"
                                        CornerRadius="8"
                                        RenderTransformOrigin="0,0.5"
                                        IsHitTestVisible="False">

                                    <!-- ScaleX 0 means the neutral hover background starts hidden. -->
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="0"
                                                        ScaleY="1" />
                                    </Border.RenderTransform>

                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <!-- Animate only when this worker can currently be purchased. -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMouseOver,
                                                                   RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                                   Value="True" />

                                                        <Condition Binding="{Binding IsEnabled,
                                                                   RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                                   Value="True" />
                                                    </MultiDataTrigger.Conditions>

                                                    <!-- Gradually fill the card from left to right. -->
                                                    <MultiDataTrigger.EnterActions>
                                                        <BeginStoryboard Storyboard="{StaticResource LeftToRightFillInStoryboard}" />
                                                    </MultiDataTrigger.EnterActions>

                                                    <MultiDataTrigger.ExitActions>
                                                        <BeginStoryboard Storyboard="{StaticResource LeftToRightFillOutStoryboard}" />
                                                    </MultiDataTrigger.ExitActions>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <!-- Purchase feedback displayed above the hover sweep. -->
                                <Border x:Name="PurchaseFlashOverlay"
                                        CornerRadius="8"
                                        IsHitTestVisible="False">
                                    <Border.Background>
                                        <SolidColorBrush
                                            Color="{StaticResource TransparentSuccessFlashColor}" />
                                    </Border.Background>
                                </Border>

                                <!-- Details and purchase controls for an unlocked worker. -->
                                <Grid Margin="12">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility"
                                                    Value="Visible" />

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMystery}"
                                                             Value="True">
                                                    <Setter Property="Visibility"
                                                            Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>



                                    <Image Grid.Column="0"
                                           Source="{Binding PortraitPath}"
                                           Width="72"
                                           Height="72"
                                           Margin="0,0,12,0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           SnapsToDevicePixels="True">

                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility"
                                                        Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PortraitPath}"
                                                                 Value="{x:Null}">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>

                                        </Image.Style>

                                    </Image>


                                    <Grid Grid.Column="1"
                                          VerticalAlignment="Center">

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Worker name and owned count -->
                                        <Grid Grid.Row="0"
                                              Margin="0,0,0,8">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding DisplayName}"
                                                       VerticalAlignment="Center"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource PrimaryTextBrush}" />

                                            <Border Grid.Column="1"
                                                    Margin="12,0,0,0"
                                                    Padding="7,3"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="8">

                                                <TextBlock FontSize="15"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryCyanBrush}">
                                                    <Run Text="× " />
                                                    <Run Text="{Binding WorkerCount,
                                                         Mode=OneWay,
                                                         Converter={StaticResource CompactNumberConverter}}" />
                                                </TextBlock>

                                            </Border>
                                        </Grid>



                                        <!-- Cost of hiring the next employee -->
                                        <StackPanel Grid.Row="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">

                                            <TextBlock Text="Next Hire"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource SecondaryTextBrush}" />

                                            <Image Source="/Assets/Icons/Currency/icon_lines_of_code.png"
                                                   Width="18"
                                                   Height="18"
                                                   Margin="0,0,4,0"
                                                   VerticalAlignment="Center"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />

                                            <TextBlock Text="{Binding CurrentCost,
                                                       Mode=OneWay,
                                                       Converter={StaticResource CompactNumberConverter}}"
                                                       VerticalAlignment="Center"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryTextBrush}" />

                                        </StackPanel>

                                    </Grid>
                                </Grid>

                                <!-- Limited information for the next locked worker. -->
                                <Grid Margin="12">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMystery}"
                                                             Value="True">
                                                    <Setter Property="Visibility"
                                                            Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <!-- Unknown worker portrait placeholder -->
                                    <Border Grid.Column="0"
                                            Width="72"
                                            Height="72"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource GameBackgroundBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">

                                        <TextBlock Text="?"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="30"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />

                                    </Border>

                                    <Grid Grid.Column="1"
                                          VerticalAlignment="Center">

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Text="???"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   />

                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding UnlockRequirementText}"
                                                   Margin="0,3,0,5"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />

                                        <StackPanel Grid.Row="2"
                                                    Orientation="Horizontal">

                                            <TextBlock Text="First hire"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource SecondaryTextBrush}" />

                                            <Image Source="/Assets/Icons/Currency/icon_lines_of_code.png"
                                                   Width="18"
                                                   Height="18"
                                                   Margin="0,0,4,0"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />

                                            <TextBlock Text="{Binding CurrentCost,
                                                       Converter={StaticResource CompactNumberConverter}}"
                                                       VerticalAlignment="Center"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryTextBrush}" />

                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
